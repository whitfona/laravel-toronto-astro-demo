---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FeatureArt from '../components/FeatureArt.astro';
const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = posts;
---

<Layout title="Cloud Notes — Ideas worth shipping">
    <main id="main">
        <section class="hero">
            <div>
                <p class="eyebrow">
                    <span></span> THE DEVELOPER’S FIELD JOURNAL
                </p>
                <h1>
                    Ideas worth
                    <br />
                    <em>shipping.</em>
                </h1>
            </div>
            <div class="hero-aside">
                <p>
                    A closer look at the tools that get you
                    <br class="desktop-break" /> from a good idea to a great deployment.
                </p>
                <span>Built with Astro. Inspired by Laravel Cloud.</span>
            </div>
        </section>
        <section class="featured" aria-label="Featured article">
            <a class="featured-art" href={`/posts/${featured.id}/`} tabindex="-1" aria-hidden="true">
                <FeatureArt kind="preview" />
            </a>
            <div class="featured-copy">
                <p class="eyebrow">
                    THE SPOTLIGHT <span class="small-rule"></span> 01
                </p>
                <span class="category">{featured.data.category}</span>
                <h2>
                    <a href={`/posts/${featured.id}/`}>{featured.data.title}</a>
                </h2>
                <p>{featured.data.description}</p>
                <div class="post-meta">
                    {featured.data.date}
                    <span>·</span>
                    {featured.data.readTime}
                </div>
                <a class="read-link" href={`/posts/${featured.id}/`}>
                    Read the story <span>↗</span>
                </a>
            </div>
        </section>
        <section id="articles" class="articles">
            <div class="section-heading">
                <h2>
                    The latest notes<span> / 004</span>
                </h2>
                <span>LESS FRICTION. MORE BUILDING.</span>
            </div>
            <div class="post-grid">
                {rest.map((post) => (
                    <article class="post-card">
                        <a href={`/posts/${post.id}/`} tabindex="-1" aria-hidden="true">
                            <FeatureArt kind={post.data.art} />
                        </a>
                        <div class="card-meta">
                            <span class="category">{post.data.category}</span>
                            <span>{post.data.readTime}</span>
                        </div>
                        <h3>
                            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                        </h3>
                        <p>{post.data.description}</p>
                        <a class="card-bottom" href={`/posts/${post.id}/`}>
                            <span>{post.data.date}</span>
                            <span aria-label="Read article">↗</span>
                        </a>
                    </article>
                ))}
            </div>
        </section>
        <section id="about" class="about">
            <span class="about-mark">✳</span>
            <div>
                <p class="eyebrow">A SMALL JOURNAL. A BIG CURIOSITY.</p>
                <h2>
                    Good tools deserve
                    <br />a closer look.
                </h2>
            </div>
            <div>
                <p>
                    Cloud Notes explores the details that make deploying feel a little simpler. Practical ideas,
                    thoughtful workflows, and features worth knowing about.
                </p>
                <a class="read-link" href="https://laravel.com/cloud/docs">
                    Keep exploring Laravel Cloud ↗
                </a>
            </div>
        </section>
    </main>
</Layout>
